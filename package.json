{
  "name": "3d-pc-builder",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n api,web \"npm:dev:server\" \"npm:dev:web\"",
    "dev:server": "node --watch server/src/index.js",
    "dev:web": "vite --config web/vite.config.js",
    "build": "vite build --config web/vite.config.js",
    "start": "NODE_ENV=production node server/src/index.js",
    "test": "node --test server/test/*.test.js",
    "format": "prettier --write web/src shared server/src server/test web/vite.config.js README.md package.json",
    "format:check": "prettier --check web/src shared server/src server/test web/vite.config.js README.md package.json"
  },
  "dependencies": {
    "@fastify/static": "^10.1.3",
    "fastify": "^5.0.0",
    "lucide-react": "^0.468.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router-dom": "^7.0.0",
    "three": "^0.180.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^5.0.0",
    "concurrently": "^9.0.0",
    "prettier": "^3.9.6",
    "vite": "^7.0.0"
  },
  "engines": {
    "node": ">=22.13.0"
  }
}
